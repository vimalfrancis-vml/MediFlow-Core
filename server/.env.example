# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# Server Port
PORT=5000

# Environment (development/production)
NODE_ENV=development

# JWT Secret (Must be at least 32 characters long; generate e.g. using `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_key_at_least_32_chars_long
JWT_EXPIRES_IN=1d
